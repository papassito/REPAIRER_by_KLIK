# Archivos de configuración y caché del sistema operativo (Windows)
# Estos archivos son generados por el sistema y no pertenecen al código fuente.
desktop.ini
Thumbs.db
ehthumbs.db

# Papelera de reciclaje
$RECYCLE.BIN/

# Artefactos de compilación de Go
# Los ejecutables y binarios compilados no deben ser versionados.
# Se generan a partir del código fuente con 'go build'.
*.exe
*.exe~
*.dll
*.so
*.dylib

/repairer
/repairer.exe